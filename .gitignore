# .env содержит настоящие токены и пароли — НИКОГДА не должен попасть
# в репозиторий (даже приватный). Секреты для GitHub Actions настраиваются
# отдельно, через "GitHub Secrets" — см. SETUP_GITHUB_ACTIONS.md
.env

# Логины/пароли брокерских площадок (Glovis, Lotte, AJ, KCar, SK, HeyDealer) —
# тоже секрет, не должен попасть в репозиторий.
credentials.json

# Сохранённые сессии входа (куки/токены) для брокерских площадок — по сути
# равнозначны паролю, пока не истекли. Тоже секрет.
*_session.json
*_cookies.json

# Локальные тестовые дампы объявлений от test_*_scraper.py (разведка более
# ранних фаз) — не секрет, но и не нужен в репозитории, чистый мусор вывода.
test_aj/
test_charancha/
test_glovis/
test_heydealer/
test_k5_sonata/
test_kcar/
test_lotte/
test_onbid/

# target_models_cache.json и published_log.json НАМЕРЕННО НЕ в .gitignore
# (как и data/cars.db/logs/*.log ниже) — main_pipeline.py запускается через
# GitHub Actions на ЧИСТОЙ виртуальной машине при каждом прогоне. Если не
# коммитить кэш резолвинга обратно в репозиторий, он не переживёт между
# прогонами и Playwright-резолвинг кодов будет заново дёргаться каждые 6
# часов вместо одного раза на новую модель. См. .github/workflows/main_pipeline.yml.
#
# yandex_queue.json/yandex_published.json — та же причина: состояние очереди
# Яндекс-черновиков (см. yandex_queue.py) должно пережить между прогонами.

# Результаты ручного model_search.py (JSON+HTML отчёт по всем 9 источникам) —
# может содержать внутренние ID дилерских лотов, локальный рабочий вывод.
model_search_results/

# Кэш Python — временные файлы, создаются автоматически, не нужны в репозитории
__pycache__/
*.pyc

# Локальные настройки Claude Code (разрешения инструментов и т.п.) — это
# конфигурация конкретного инструмента разработки на этом компьютере, не
# часть самого проекта. Исключение — .claude/skills/channel-post-automation/
# ниже: это ПРОЕКТНЫЙ скилл (рунбук автопостинга), намеренно в git, а не
# личная настройка машины. Многоуровневый негейт обязателен: если бы .claude/
# было проигнорено одной строкой, git вообще не заходил бы внутрь директории,
# и точечный !.claude/skills/channel-post-automation/ ниже ни на что не подействовал бы.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/channel-post-automation/

# Отладочный файл, который scraper.py создаёт при сбое парсинга
debug_last_failed_page.txt

# ВАЖНО: data/cars.db и logs/app.log НАМЕРЕННО НЕ добавлены сюда!
# Их нужно коммитить в репозиторий — иначе GitHub Actions не будет
# "помнить" между запусками, что уже опубликовано (см. пояснение в
# .github/workflows/run_bot.yml).

# rejected_posts.log (post_validator.py) — НАОБОРОТ, коммитить не нужно:
# это не состояние дедупа (как published_log.json), а чисто диагностический
# след ОДНОГО конкретного прогона. Каждый прогон GitHub Actions начинается
# на чистой машине (файла ещё нет) — если в НЕМ появились новые записи,
# шаг "Проверить rejected_posts.log" в workflow сам зафейлит job (exit 1),
# сохранять историю reject'ов между прогонами не нужно.
rejected_posts.log

# Готовые ролики видео-инструментов (content_reels_publisher.py) — это
# результат работы, а не исходники: гигабайты .mp4, которым не место в git.
output/
output_reels/
content_reels.log

# Видео-артефакты в любом месте дерева.
*.mp4

# Прочие .log — мусор конкретного прогона. ИСКЛЮЧЕНИЕ ниже обязательно:
# logs/app.log и logs/main_pipeline.log НАМЕРЕННО отслеживаются (см. большой
# комментарий выше) — GitHub Actions запускается на чистой VM и без них
# теряет память о том, что уже опубликовано. Без этих двух "!" правило
# *.log противоречило бы тому решению.
*.log
!logs/app.log
!logs/main_pipeline.log

# Регресс-тест shorts_generator — локальный, в репозитории не нужен.
test_shorts.py
