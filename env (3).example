# ═══════════════════════════════════════════════════════════════════
# Пример файла настроек. Скопируй этот файл, назови его ".env"
# (без "example" в конце!) и впиши свои реальные значения.
#
# .env — это файл с секретными настройками (токены, ID), который
# НЕ показывается никому и не выкладывается в открытый доступ.
# ═══════════════════════════════════════════════════════════════════

# Токен твоего Telegram-бота. Получить у @BotFather в Telegram:
# напиши ему /newbot, следуй инструкциям, он пришлёт токен вида
# "123456789:AAExampleTokenHere"
BOT_TOKEN=вставь_сюда_свой_токен

# ID или username канала, куда публиковать посты.
# Если канал публичный — можно просто "@имя_канала"
# Если приватный — нужен числовой ID (обычно начинается с -100...)
TELEGRAM_CHAT_ID=@auto_generals

# Пауза между запросами к сайту дилера (секунды).
# Не ставь слишком маленькое число — сайт может заблокировать твой IP,
# если слать запросы слишком часто.
REQUEST_DELAY_SECONDS=3

# Путь к файлу базы данных (создастся автоматически при первом запуске)
DATABASE_PATH=data/cars.db

# Путь к файлу лога (тоже создастся автоматически)
LOG_FILE_PATH=logs/app.log

# ─── Доп. расходы для расчёта цены "под ключ" (в рублях) ───
# Если статья не нужна — оставь 0.
LOGISTICS_RUB=300000
BROKER_FEE_RUB=100000
MARGIN_RUB=150000

# Кто ввозит: 'phys' (физлицо, льготный утильсбор) или 'legal' (юрлицо)
IMPORTER_TYPE=phys

# ─── Claude API — для "умной" генерации постов (post_generator.py) ───
# Получить ключ: console.anthropic.com -> Account Settings -> API Keys
# Если оставить пустым — бот использует обычный шаблонный текст постов,
# программа не упадёт.
ANTHROPIC_API_KEY=
